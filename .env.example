# ── Wajib ────────────────────────────────────────────────────────────────────
# PostgreSQL (Supabase atau Postgres biasa).
# Format Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Wajib secara teknis, tapi boleh kosong untuk demo lokal ──────────────────
# `src/lib/server/env.ts` memanggil required() untuk keempat variabel di bawah,
# jadi isi dengan string kosong pun tetap harus ada di file .env.
#
# Supabase Auth: kosongkan untuk memakai sesi dev lokal (login diverifikasi
# langsung ke database dengan akun demo dari scripts/seed.mjs).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary untuk penyimpanan berkas. Tanpa ini, unggahan disimpan ke disk
# lokal (.data/uploads) dan disajikan lewat /files/[id] dengan RBAC + gerbang
# pembayaran. Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
